# PostgreSQL Database Connection Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=social_intelligence

# Or provide full direct PostgreSQL Connection URI:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/social_intelligence

# Server Settings
PORT=8000
HOST=0.0.0.0

# Email & SMTP Settings (Optional - For sending real emails to users)
# If left blank, the system automatically uses in-memory live dispatch with dev previews
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM=no-reply@socialmediaanalytics.io
